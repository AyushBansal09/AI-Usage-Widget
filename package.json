{
  "name": "ai-usage-widget",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first dashboard for AI coding agents: tokens left, what each agent is doing, and how efficiently tokens are being spent.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter @ai-usage-widget/server run dev",
    "start": "pnpm --filter @ai-usage-widget/server run start",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "pnpm -r --filter './packages/*' run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
